{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "baseUrl": ".",
    "paths": {
      "@types/*": ["src/types/*"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/types/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
