# 실시간(WebSocket) 서버 설정
PORT=8080
HOST=127.0.0.1

# Redis: FastAPI가 발행하는 alert.created / document.* / realtime.events를 구독한다.
REDIS_URL=redis://127.0.0.1:6379/0

# FastAPI 백엔드 주소 (통합 실행 기준)
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_TIMEOUT_MS=10000

# JWT: 반드시 backend/.env의 SECRET_KEY와 동일해야 WebSocket 인증이 통과한다.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# FastAPI realtime 채널명 (backend/.env와 동일해야 한다)
REALTIME_EVENT_CHANNEL=realtime.events
