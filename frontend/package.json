{
  "name": "meeting-ai-desktop",
  "productName": "MeetingAI",
  "private": true,
  "description": "AI 회의 보조 데스크톱 클라이언트",
  "author": "MeetingAI Team",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit --incremental false && tsc -p tsconfig.node.json --noEmit --incremental false && vite build --configLoader runner",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dist": "npm run build && electron-builder --mac --publish never",
    "dist:dir": "npm run build && electron-builder --mac --dir --publish never"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "axios": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  },
  "build": {
    "appId": "com.b42.meetingai",
    "productName": "MeetingAI",
    "directories": {
      "output": "../dist-app",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/.venv/**",
          "!**/uploads/**",
          "!**/tests/**",
          "!**/docs/**",
          "!.env",
          "!.env.*"
        ]
      },
      {
        "from": "../realtime-server",
        "to": "realtime-server",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/docs/**",
          "!**/node_modules/**",
          "!.env",
          "!.env.*"
        ]
      },
      {
        "from": "../docker-compose.yml",
        "to": "docker-compose.yml"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "MeetingAI-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "회의 녹음을 위해 마이크를 사용합니다.",
        "NSAppleEventsUsageDescription": "회의 분석 서버를 실행하기 위해 필요합니다."
      },
      "identity": null
    },
    "dmg": {
      "title": "AI 회의 보조 ${version}"
    },
    "afterPack": "./scripts/after-pack.cjs"
  }
}
