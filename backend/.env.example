DATABASE_URL=postgresql://postgres:replace-with-your-local-db-password@127.0.0.1:5433/meeting_ai_db
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
# Redis server is owned by the Node.js realtime server.
# FastAPI only connects to that external Redis for publish.
REDIS_URL=redis://127.0.0.1:6379/0
ALERT_CREATED_CHANNEL=alert.created
MEETING_UPDATED_CHANNEL=meeting.updated
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
APP_VERSION=0.4.0
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
REALTIME_EVENT_CHANNEL=realtime.events
REALTIME_EVENT_STREAM=realtime.events.stream
REALTIME_STREAM_MAXLEN=10000
FASTAPI_URL=http://127.0.0.1:8000
NODE_PORT=3001
ANALYSIS_SERVER_URL=http://127.0.0.1:8000
ANALYSIS_TIMEOUT_SECONDS=3
# ANALYSIS_SERVER_URL을 켜면 두 서버가 공유하는 내부 계약 인증키가 필수다.
ANALYSIS_CALLBACK_SECRET=replace-with-a-long-random-secret
AI_REANALYSIS_URL=http://127.0.0.1:3001/internal/ai/re-analyze
AI_RESULT_CALLBACK_SECRET=replace-with-a-long-random-secret
AUDIO_SIGNING_SECRET=replace-with-a-long-random-secret
AUDIO_SIGNED_URL_TTL_SECONDS=300
AUDIO_STORAGE_ROOT=uploads/audio
DOCUMENT_MAX_UPLOAD_MB=50
REALTIME_CONTEXT_SIZE=20
REALTIME_CONTEXT_MAX_CHARS=8000

# 로컬 LLM (Electron 앱이 Ollama를 자동 기동하고 모델을 준비한다)
LLM_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=180

# 실제 마이크 녹음 STT / 화자 분리
STT_ENABLED=true
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ko
STT_MAX_UPLOAD_MB=200
STT_TEMPERATURE=0.0
STT_INITIAL_PROMPT=회의 안건, 결정사항, 액션 아이템을 정확히 전사합니다.
STT_CONDITION_ON_PREVIOUS_TEXT=true
STT_VAD_FILTER=true
STT_VAD_MIN_SILENCE_MS=500
STT_REMOVE_FILLERS=true
DIARIZATION_ENABLED=true
DIARIZATION_MODEL=speechbrain/spkrec-ecapa-voxceleb
DIARIZATION_CLUSTER_THRESHOLD=0.85

# Phase 4 (RAG / speaker / rediscussion)
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=256
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_SEARCH_TOP_K=5
REDISCUSSION_SIMILARITY_THRESHOLD=0.4
SPEAKER_SIMILARITY_THRESHOLD=0.75
